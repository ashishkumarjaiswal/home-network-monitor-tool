# Coolify / local — copy to .env and fill in real values.
# Never commit real secrets.

# On Coolify (same Docker network as Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_INTERNAL_HOST:5432/monitor?schema=public"
#
# From Mac (only if you expose Postgres TCP in Coolify, e.g. 192.168.31.7:5432):
DATABASE_URL="postgresql://postgres:CHANGE_ME@192.168.31.7:5432/postgres?schema=public"

ADGUARD_URL="http://192.168.31.7:4001"
ADGUARD_USER="admin"
ADGUARD_PASSWORD="CHANGE_ME"

OMNIROUTE_URL="http://192.168.31.7:20128/v1"
OMNIROUTE_API_KEY="CHANGE_ME"
OMNIROUTE_MODEL="auto"

# Gateway agent on Ubuntu host (not Coolify)
GATEWAY_AGENT_URL="http://192.168.31.7:4010"
GATEWAY_AGENT_TOKEN="CHANGE_ME"
WORKER_INTERVAL_MS="60000"

# Telegram daily digests (BotFather token + your numeric user id)
TELEGRAM_BOT_TOKEN="CHANGE_ME"
TELEGRAM_CHAT_ID="CHANGE_ME"
DIGEST_TZ="Asia/Kolkata"
DIGEST_HOUR="21"
